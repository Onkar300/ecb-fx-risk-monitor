essage": null, "failures": null, "unique_id": "test.ecb_risk.not_null_stg_fx_long_series_id.415673a775", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect series_id\nfrom \"ecb_risk\".\"analytics_staging\".\"stg_fx_long\"\nwhere series_id is null\n\n\n", "relation_name": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-05-29T20:13:27.433062Z", "completed_at": "2026-05-29T20:13:27.464104Z"}, {"name": "execute", "started_at": "2026-05-29T20:13:27.467078Z", "completed_at": "2026-05-29T20:13:27.467078Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.04816293716430664, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.ecb_risk.stg_inflation", "compiled": true, "compiled_code": "-- HICP forward-filled onto the daily business-day calendar.\n\n\nwith hicp as (\n    select\n        obs_date as hicp_month,\n        cast(value as numeric(8, 4)) as hicp_yoy_pct\n    from \"ecb_risk\".\"raw\".\"observations\"\n    where series_group = 'inflation'\n      and series_id    = 'HICP_ALL_ANR'\n      and value is not null\n)\nselect\n    c.cal_date as obs_date,\n    h.hicp_month,\n    h.hicp_yoy_pct\nfrom \"ecb_risk\".\"analytics_staging\".\"stg_calendar\" c\nleft join lateral (\n    select hicp_month, hicp_yoy_pct\n    from hicp\n    where hicp_month <= c.cal_date\n    order by hicp_month desc\n    limit 1\n) h on true", "relation_name": "\"ecb_risk\".\"analytics_staging\".\"stg_inflation\""}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-05-29T20:13:27.453218Z", "completed_at": "2026-05-29T20:13:27.470079Z"}, {"name": "execute", "started_at": "2026-05-29T20:13:27.475431Z", "completed_at": "2026-05-29T20:13:27.475431Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.04336905479431152, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.ecb_risk.unique_stg_calendar_cal_date.fae5f55a61", "compiled": true, "compiled_code": "\n    \n    \n\nselect\n    cal_date as unique_field,\n    count(*) as n_records\n\nfrom \"ecb_risk\".\"analytics_staging\".\"stg_calendar\"\nwhere cal_date is not null\ngroup by cal_date\nhaving count(*) > 1\n\n\n", "relation_name": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-05-29T20:13:27.444618Z", "completed_at": "2026-05-29T20:13:27.471079Z"}, {"name": "execute", "started_at": "2026-05-29T20:13:27.476419Z", "completed_at": "2026-05-29T20:13:27.476419Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.046357154846191406, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.ecb_risk.not_null_stg_calendar_cal_date.2898a02949", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect cal_date\nfrom \"ecb_risk\".\"analytics_staging\".\"stg_calendar\"\nwhere cal_date is null\n\n\n", "relation_name": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-05-29T20:13:27.479428Z", "completed_at": "2026-05-29T20:13:27.502727Z"}, {"name": "execute", "started_at": "2026-05-29T20:13:27.506099Z", "completed_at": "2026-05-29T20:13:27.507216Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.03812360763549805, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.ecb_risk.not_null_stg_policy_rates_wide_obs_date.2386e7f642", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect obs_date\nfrom \"ecb_risk\".\"analytics_staging\".\"stg_policy_rates_wide\"\nwhere obs_date is null\n\n\n", "relation_name": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-05-29T20:13:27.492745Z", "completed_at": "2026-05-29T20:13:27.520226Z"}, {"name": "execute", "started_at": "2026-05-29T20:13:27.527488Z", "completed_at": "2026-05-29T20:13:27.527488Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.04905986785888672, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.ecb_risk.unique_stg_policy_rates_wide_obs_date.5486cd3dea", "compiled": true, "compiled_code": "\n    \n    \n\nselect\n    obs_date as unique_field,\n    count(*) as n_records\n\nfrom \"ecb_risk\".\"analytics_staging\".\"stg_policy_rates_wide\"\nwhere obs_date is not null\ngroup by obs_date\nhaving count(*) > 1\n\n\n", "relation_name": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-05-29T20:13:27.508217Z", "completed_at": "2026-05-29T20:13:27.531485Z"}, {"name": "execute", "started_at": "2026-05-29T20:13:27.535497Z", "completed_at": "2026-05-29T20:13:27.535497Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.0448756217956543, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.ecb_risk.fct_fx_returns", "compiled": true, "compiled_code": "-- Daily FX log returns per pair, long form for downstream metric work.\n\n\nwith pivoted as (\n    select * from \"ecb_risk\".\"analytics_staging\".\"stg_fx_wide\"\n),\nreturns as (\n    select\n        obs_date,\n        ln(eur_usd / nullif(lag(eur_usd) over (order by obs_date), 0)) as ret_eur_usd,\n        ln(eur_gbp / nullif(lag(eur_gbp) over (order by obs_date), 0)) as ret_eur_gbp,\n        ln(eur_jpy / nullif(lag(eur_jpy) over (order by obs_date), 0)) as ret_eur_jpy,\n        ln(eur_chf / nullif(lag(eur_chf) over (order by obs_date), 0)) as ret_eur_chf\n    from pivoted\n)\n-- Unpivot to long: easier for the dashboard + metrics module to filter by pair.\nselect obs_date, 'EUR_USD'::text as pair, ret_eur_usd as log_return from returns where ret_eur_usd is not null\nunion all\nselect obs_date, 'EUR_GBP', ret_eur_gbp from returns where ret_eur_gbp is not null\nunion all\nselect obs_date, 'EUR_JPY', ret_eur_jpy from returns where ret_eur_jpy is not null\nunion all\nselect obs_date, 'EUR_CHF', ret_eur_chf from returns where ret_eur_chf is not null", "relation_name": "\"ecb_risk\".\"analytics_marts\".\"fct_fx_returns\""}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-05-29T20:13:27.514