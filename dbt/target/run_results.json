bp,\n    fx.eur_jpy,\n    fx.eur_chf,\n    pr.mro_rate,\n    pr.dfr_rate,\n    pr.mlf_rate,\n    inf.hicp_yoy_pct\nfrom \"ecb_risk\".\"analytics_staging\".\"stg_calendar\" c\nleft join \"ecb_risk\".\"analytics_staging\".\"stg_fx_wide\"            fx  on fx.obs_date  = c.cal_date\nleft join \"ecb_risk\".\"analytics_staging\".\"stg_policy_rates_wide\"  pr  on pr.obs_date  = c.cal_date\nleft join \"ecb_risk\".\"analytics_staging\".\"stg_inflation\"          inf on inf.obs_date = c.cal_date", "relation_name": "\"ecb_risk\".\"analytics_marts\".\"fct_macro_snapshot\""}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-05-29T20:13:27.566914Z", "completed_at": "2026-05-29T20:13:27.588767Z"}, {"name": "execute", "started_at": "2026-05-29T20:13:27.593421Z", "completed_at": "2026-05-29T20:13:27.593421Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.04128766059875488, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.ecb_risk.not_null_stg_inflation_obs_date.3d8582eb22", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect obs_date\nfrom \"ecb_risk\".\"analytics_staging\".\"stg_inflation\"\nwhere obs_date is null\n\n\n", "relation_name": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-05-29T20:13:27.575932Z", "completed_at": "2026-05-29T20:13:27.590425Z"}, {"name": "execute", "started_at": "2026-05-29T20:13:27.596425Z", "completed_at": "2026-05-29T20:13:27.596425Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.03551936149597168, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.ecb_risk.unique_stg_inflation_obs_date.1b9a3e7016", "compiled": true, "compiled_code": "\n    \n    \n\nselect\n    obs_date as unique_field,\n    count(*) as n_records\n\nfrom \"ecb_risk\".\"analytics_staging\".\"stg_inflation\"\nwhere obs_date is not null\ngroup by obs_date\nhaving count(*) > 1\n\n\n", "relation_name": null}, {"status": "success", "timing": [{"n